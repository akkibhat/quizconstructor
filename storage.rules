rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // This app only ever has one possible signed-in identity - the single
    // host account (there's no public signup, see lib/hooks/useAuth.ts).
    // So "signed in" and "is the host" are equivalent here, and checking
    // per-quiz ownership via a Storage-rules-to-Firestore cross-reference
    // isn't worth the reliability risk that approach carries - keep it to
    // a plain auth check.
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isValidAudio() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // /quizzes/{quizId}/questions/{questionId}/image.<ext> or audio.<ext>
    // Long Game clues use this same path too, since clues are stored as
    // that round's "questions" - see Round.isLongGame.
    match /quizzes/{quizId}/questions/{questionId}/{fileName} {
      allow read: if true;
      allow delete: if isSignedIn();
      allow create, update: if isSignedIn()
        && (
          (fileName.matches('image\\..*') && isValidImage())
          || (fileName.matches('audio\\..*') && isValidAudio())
        );
    }
  }
}
